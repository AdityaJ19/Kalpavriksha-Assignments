void selectionSort(Node* head){
    if(head == NULL || head->next == NULL)
        return;
    
    Node* curr = head;
    
    while(curr != NULL){
        Node* minVal = curr;
        Node* temp = curr->next;
    while(temp != NULL){
    if(temp->data < minVal->data){
        minVal = temp;
    }
    temp = temp->next;
    }
    
    if(minVal != curr){
        int tempData = curr->data;
        curr->data = minVal->data;
        minVal->data = tempData;
    }
    curr = curr->next;
    }
}

void LLtraverse(Node* head){
    Node* temp = head;
    
    while(temp!= NULL){
        printf("%d->", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

void LLAddNode(int value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL) {
        head = newNode;
        return;
    }
    Node* temp = head;
    while (temp->next != NULL) {
        temp = temp->next;
    }
    temp->next = newNode;
}

