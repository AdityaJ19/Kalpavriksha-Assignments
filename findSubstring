#include <stdio.h>
#include <string.h>

int findPosition(char* str, char* target) {
    char *position = strstr(str, target);
    if (position != NULL) {
        return position - str;
    } else {
        return -1;
    }
}

int main() {
    char str[100];
    fgets(str, sizeof(str), stdin);
    
    str[strcspn(str, "\n")] = '\0';
    
    char target[50];
    scanf("%s", target);
    
    int index = findPosition(str, target);
    
    if (index != -1) {
        printf("%d\n", index);
    } else {
        printf("-1\n");
    }
    return 0;
}
