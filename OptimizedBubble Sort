#include <stdio.h>

void swapped(int *a, int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}

void bubbleSort(int *arr, int n){
    int i,j,swap;
    for(i = 0; i < n-1; i++){
        swap = 0;
        for(j = 0; j < n - i - 1; j++){
            if(arr[j] > arr[j+1]){
                swapped(&arr[j], &arr[j+1]);
                swap = 1;
            }
        }
        if(swap == 0){
            break;
        }
    }
}
int main()
{
    int n;
    printf("Enter the no of Elements: ");
    scanf("%d", &n);
    
    int arr[n];
    printf("Elements are: ");
    for(int i =0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    bubbleSort(arr, n);
    printf("Print Sorted Elements: ");
    for(int i = 0; i< n; i++){
        printf("%d ", arr[i]);
    }

    return 0;
}
