#include <stdio.h>
#include <stdlib.h>

typedef struct Node{
    int data;
    struct Node* next;
}Node;

Node* head = NULL;

void bubbleSort(Node* head) {
    if (!head || !head->next)
        return;

    Node* end = NULL;

    while (end != head) {
        Node* curr = head;
        Node* front = head->next;
        while (front != end) {
            if (curr->data > front->data) {
                int temp = curr->data;
                curr->data = front->data;
                front->data = temp;
            }
            curr = front; 
            front = front->next;
        }
        end = curr;
    }
}

void LLtraverse(Node* head){
    Node* temp = head;
    
    while(temp!= NULL){
        printf("%d->", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

void LLAddNode(int value) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL) {
        head = newNode;
        return;
    }

    Node* temp = head;
    while (temp->next != NULL) {
        temp = temp->next;
    }
    temp->next = newNode;
}


int main(){
    int n, value;
        scanf("%d", &n);
        for (int i = 0; i < n; i++) {
        scanf("%d", &value);
        LLAddNode(value);
    }
    bubbleSort(head);
    LLtraverse(head);
    return 0;
}
