#include <stdio.h>
#include <stdlib.h>

void printArray(int *arr, int size){
    int i;
    for (i = 0; i < size; i++)
        printf("%d ", arr[i]);
    printf("\n");
}

void merge(int *arr, int low, int mid, int high){
    int i, j, k;
    int *arr1 = (int *)malloc((high - low + 1) * sizeof(int));
    
    i = low;
    j = mid + 1;
    k = 0;

    while(i <= mid && j <= high){
        if(arr[i] < arr[j]){
            arr1[k] = arr[i];
            i++;
        }else{
            arr1[k] = arr[j];
            j++;
        }
        k++;
    }
    while(i <= mid){
        arr1[k] = arr[i];
        i++;
        k++;
    }
    while(j <= high){
        arr1[k] = arr[j];
        j++;
        k++;
    }
    for(i = low; i <= high; i++) {
        arr[i] = arr1[i - low];
    }
    free(arr1);
}

void mergeSort(int *arr, int left, int right){
    if (left < right){
        int mid = (left + right)/2;
        mergeSort(arr, left, mid);
        mergeSort(arr, mid + 1, right);
        merge(arr, left, mid, right);
    }
}

int main(){
    int n;
    printf("Enter no of elements: ");
    scanf("%d", &n);

    int *arr = (int *)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }

    printf("Original array: ");
    printArray(arr, n);

    mergeSort(arr, 0, n-1);
    printf("Sorted array: ");
    printArray(arr, n);
    free(arr);

    return 0;
}
