#include <stdio.h>
#include <string.h>

// Function to get the length of a string
int stringLength(char string[]) {
    int length = 0;
    while (string[length] != '\0') {
        length++;
    }
    return length;
}

void myStrCat(char* string1, char* string2){
    while(*string1 != '\0'){
        string1++;
    }
    while(*string2 != '\0'){
        *string1 = *string2;
        string1++;
        string2++;
    }
    *string1 = '\0';
}

int isSubstring(char* string,char* subString){
    int string_length=stringLength(string);
    int subString_length=stringLength(subString);
    for(int i=0;i<string_length;i++){
        if(subString[0]==string[i]){
            int start=i;
            int j=0;
            while(j<subString_length && subString[j]==string[j+i]){
                j++;
                }
            if(j==subString_length){
                return start;
                break;
            }
            }
        }
    return -1;
}

int isRotation(char string1[], char string2[]) {
    int length1 = stringLength(string1);
    int length2 = stringLength(string2);

    if (length1 != length2) {
        return 0;
    }

    char concatenated[200] = "";
    myStrCat(concatenated, string1);
    myStrCat(concatenated, string1);

    return isSubstring(concatenated, string2);
}

int main() {
    char string1[100], string2[100];

    printf("Enter first string: ");
    scanf("%s", string1);

    printf("Enter rotated string: ");
    scanf("%s", string2);

    if (isRotation(string1, string2)) {
        printf("True: '%s' is a rotation of '%s'\n", string2, string1);
    } else {
        printf("False: '%s' is not a rotation of '%s'\n", string2, string1);
    }

    return 0;
}
