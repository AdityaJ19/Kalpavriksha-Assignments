#include <stdio.h>

int linearSearch(int* arr, int target, int len){
    for(int i = 0; i < len; i++){
        if(arr[i] == target){
            return i;
        }
    }
    return -1;
}

int main(){
    int n, target;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int *arr = (int*)malloc(n*sizeof(int));

    for (int i = 0; i < n; i++){
        scanf("%d", &arr[i]);
    }

    printf("Target Element: ");
    scanf("%d", &target);

    int result = linearSearch(arr, target, n);
    
    if(result == -1){
        printf("Element not present.\n");
    } else {
        printf("Element present at index: %d\n", result);
    }
    free(arr);
    return 0;
}
