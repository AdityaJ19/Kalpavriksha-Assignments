#include <stdio.h>

void swapped(int *a, int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}

void insertionSort(int *arr, int n){
    int i,j;
    
    for(i = 0; i< n; i++){
        for(j = i+1; j>0; j--){
            if(arr[j] < arr[j-1]){
                swapped(&arr[j], &arr[j-1]);
            }else{
                break;
            }
        }
    }
}

int main()
{
    int n;
    printf("Enter the no of Elements: ");
    scanf("%d", &n);
    
    int arr[n];
    printf("Elements are: ");
    for(int i =0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    insertionSort(arr, n);
    printf("Print Sorted Elements: ");
    for(int i = 0; i< n; i++){
        printf("%d ", arr[i]);
    }

    return 0;
}
