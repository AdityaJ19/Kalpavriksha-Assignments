#include <stdio.h>

void swapped(int *a, int *b){
    int temp = *a;
    *a = *b;
    *b = temp;
}

void selectionSort(int *arr, int n){
    int i, j;
    for(i =0; i<n-1; i++){
        int minVal = i;
        for(j = i+1; j<n; j++){
            if(arr[j] < arr[minVal]){
                minVal = j;
            }
        }
        swapped(&arr[minVal], &arr[i]);
    }
}

int main()
{
    int n;
    printf("Enter the no of Elements: ");
    scanf("%d", &n);
    
    int arr[n];
    printf("Elements are: ");
    for(int i =0; i<n; i++){
        scanf("%d", &arr[i]);
    }
    selectionSort(arr, n);
    printf("Print Sorted Elements: ");
    for(int i = 0; i< n; i++){
        printf("%d ", arr[i]);
    }

    return 0;
}
